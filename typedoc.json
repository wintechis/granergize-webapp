{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "tsconfig.check.json",
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"],
  "out": "docs/api",
  "name": "Granergize app — source reference",
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "validation": {
    "invalidLink": false,
    "notExported": false
  }
}
