@prefix : <#> .
@prefix gra: <https://solid.ti.rw.fau.de/private/granergize/vocab.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix buildings: <https://solid.ti.rw.fau.de/private/granergize/buildings.ttl#> .

#########################################################
# Energy Need Observations
#########################################################

# Electricity Need Observation
:ElectricityNeedObs a sosa:Observation ;
    sosa:observedProperty gra:Electricity ;
    sosa:hasFeatureOfInterest buildings:10226 ;
    sosa:hasResult [
        a sosa:Result ;
        sosa:hasSimpleResult "314266"^^xsd:float ;
        ssn:hasUnit "kWh"
    ] ;
    sosa:phenomenonTime [
        time:hasBeginning "2023-01-01T00:00:00Z"^^xsd:dateTime ;
        time:hasEnd "2023-12-31T23:59:59Z"^^xsd:dateTime
    ] .

