# GRANERGIZE role shapes (ShEx 2.1 / ShExC)
#
# One shape per UserRole. These formalise the *de-facto* graph shapes that are
# currently encoded imperatively across:
#   - src/services/utils/config/buildingConfig.ts  (predicate maps)
#   - src/services/utils/buildingParser.ts          (blank-node structure)
#   - src/services/utils/energyDataParser.ts        (energy graph shapes)
#   - src/services/utils/userEnergyParser.ts        (user time series)
#
# Status: DRAFT / documentation. Nothing in the app validates against these yet.
# See ROLES.md for how they are intended to be used (validate + infer-on-missing,
# NOT as the primary role discriminator).
#
# Uses EXTENDS (ShEx 2.1) — supported by shex.js. If your validator predates
# 2.1, inline <BuildingCore> into each role shape or use shape conjunction (AND).
#
# Note on datatypes: where a triple constraint uses a bare "." (any value), the
# app parses the literal in JS (see parsingFunctions) but the underlying RDF
# literal is often looser than the parsed type (e.g. postal-code is frequently a
# plain string). Treat the named xsd datatypes as intent, not a hard constraint.
# Everything is optional because real Pod data is routinely partial.

PREFIX gran:     <https://solid.ti.rw.fau.de/private/granergize/vocab.ttl#>
PREFIX uservoc:  <https://solid.ti.rw.fau.de/private/granergize/user-vocab.ttl#>
PREFIX investor: <https://solid.ti.rw.fau.de/private/granergize/investor-vocab.ttl#>
PREFIX bench:    <https://solid.ti.rw.fau.de/private/granergize/benchmark-vocab.ttl#>
PREFIX rec:      <https://w3id.org/rec#>
PREFIX schema:   <http://schema.org/>
PREFIX vcard:    <http://www.w3.org/2006/vcard/ns#>
PREFIX geo:      <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sosa:     <http://www.w3.org/ns/sosa/>
PREFIX ssn:      <http://www.w3.org/ns/ssn/>
PREFIX time:     <http://www.w3.org/2006/time#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

# ─────────────────────────────────────────────────────────────────────────────
# Core building shape — predicates shared by ALL roles.
# Source: predicateMap in buildingConfig.ts.
# ─────────────────────────────────────────────────────────────────────────────
<BuildingCore> {
  rdf:type                  [ rec:building ] ;
  schema:customer           xsd:string  ? ;
  geo:lat                   xsd:decimal ? ;
  geo:long                  xsd:decimal ? ;
  vcard:locality            xsd:string  ? ;
  vcard:postal-code         .           ? ;   # parseInt'd in app
  vcard:region              xsd:string  ? ;
  vcard:street-address      xsd:string  ? ;
  rdfs:label                xsd:string  ? ;
  gran:hasBuildingArea      .           ? ;   # parseInt'd
  gran:hasLandArea          .           ? ;   # parseInt'd
  gran:hasPVSystem          xsd:boolean ? ;
  gran:investor             .           ? ;
  gran:officeArea           .           ? ;   # parseInt'd
  gran:usedAs               xsd:string  ? ;
  gran:yearOfConstruction   .           ? ;   # parseInt'd
  gran:hasEnergyCertificate xsd:string  ? ;
  rec:nace-code             .           ? ;   # parseFloat
  rec:operatedBy            .           ? ;   # agent IRI
}

# Reference to an external energy dataset (Dummy / Benchmark / User building
# files). buildingParser links these via a blank node; the file at
# gran:datasetLocation holds the actual observations/readings.
# Source: buildingParser.ts:215 (energyDataMap branch).
<EnergyDatasetRef> BlankNode {
  gran:measurementYear    xsd:integer ? ;     # measurementYear OR datasetDate
  gran:datasetDate        xsd:date    ? ;     #   supplies the "year"
  gran:datasetLocation    .           ;       # relative or absolute IRI to the energy file
  gran:type               xsd:string  ? ;
}

# ─────────────────────────────────────────────────────────────────────────────
# DUMMY role  (gran:DummyRole) — the baseline / backward-compat shape.
# Core + (optional) external energy dataset references. No role-specific preds.
# ─────────────────────────────────────────────────────────────────────────────
<DummyBuilding> EXTENDS @<BuildingCore> {
  ( gran:hasEnergyMeasurementData    @<EnergyDatasetRef> |
    gran:hasEnergyConsumptionDataset @<EnergyDatasetRef> ) * ;
}

# ─────────────────────────────────────────────────────────────────────────────
# USER role  (gran:UserRoleInstance)
#
# IMPORTANT: at the *building-file* level this is structurally IDENTICAL to
# <DummyBuilding> — core + gran:hasEnergyConsumptionDataset references. The role
# is only distinguishable by the *content of the referenced energy file*
# (uservoc:EnergyConsumptionReading vs. sosa:Observation). This is the single
# clearest reason shape-detection on the building file cannot recover the role,
# and why the declared gran:dataSourceRole annotation is kept authoritative.
# ─────────────────────────────────────────────────────────────────────────────
<UserBuilding> EXTENDS @<BuildingCore> {
  ( gran:hasEnergyMeasurementData    @<EnergyDatasetRef> |
    gran:hasEnergyConsumptionDataset @<EnergyDatasetRef> ) * ;
}

# ─────────────────────────────────────────────────────────────────────────────
# BENCHMARK role  (gran:BenchmarkRole)
# Core + benchmark-vocab predicates. Energy via external sosa:Observation files
# (same mechanism as Dummy). Source: BENCH_NS entries in buildingConfig.ts.
# Signature predicates (any one ⇒ benchmark): bench:companyName,
# bench:logisticsFunction, bench:pvCapacityKW, ...
# ─────────────────────────────────────────────────────────────────────────────
<BenchmarkBuilding> EXTENDS @<BuildingCore> {
  bench:companyName        xsd:string  ? ;
  bench:logisticsFunction  xsd:string  ? ;
  bench:climateControlType xsd:string  ? ;
  bench:greenLeaseShare    .           ? ;   # parseFloat
  bench:indoorTemperature  xsd:string  ? ;
  bench:pvInstallationYear .           ? ;   # parseInt
  bench:pvCapacityKW       .           ? ;   # parseFloat
  ( gran:hasEnergyMeasurementData    @<EnergyDatasetRef> |
    gran:hasEnergyConsumptionDataset @<EnergyDatasetRef> ) * ;
}

# ─────────────────────────────────────────────────────────────────────────────
# INVESTOR role  (gran:InvestorRole) — richest shape.
# Core + investor-vocab datatype/object predicates + blank-node sub-structures
# (operating costs, certifications) + INLINE SOSA observations (no separate
# energy files). Sources: INVESTOR_NS entries in buildingConfig.ts and the
# blank-node passes in buildingParser.ts.
# ─────────────────────────────────────────────────────────────────────────────
<InvestorBuilding> EXTENDS @<BuildingCore> {
  # datatype predicates
  investor:buildingCode         xsd:string  ? ;
  investor:hallArea             .           ? ;   # parseFloat
  investor:officeSocialArea     .           ? ;   # parseFloat
  investor:buildingHeight       .           ? ;   # parseFloat
  investor:numberOfLoadingDocks .           ? ;   # parseInt
  investor:yearOfRenovation     .           ? ;   # parseInt
  investor:leaseType            xsd:string  ? ;
  investor:tenantIndustry       xsd:string  ? ;
  investor:hasOilBoiler         xsd:boolean ? ;
  investor:hasGasBoiler         xsd:boolean ? ;
  investor:hasElectricBoiler    xsd:boolean ? ;
  investor:hasHeatPump          xsd:boolean ? ;
  investor:hasDistrictHeating   xsd:boolean ? ;

  # controlled-vocabulary object properties (IRI value sets → localName labels)
  investor:shiftRegime
    [ investor:OneShift investor:TwoShift investor:ThreeShift ] ? ;
  investor:tenancyType
    [ investor:SingleTenant investor:MultiTenant ] ? ;
  investor:indoorTemperatureClass
    [ investor:MaxTwelveDegrees investor:MaxEighteenDegrees ] ? ;

  # blank-node sub-structures
  investor:hasOperatingCosts        @<OperatingCosts> ? ;
  investor:hasBuildingCertification @<Certification>  * ;
  investor:hasInvestorAnnualData    BlankNode         * ;   # association only; values
                                                            # live in inline observations
}

# Investor energy is carried as inline SOSA observations whose
# sosa:hasFeatureOfInterest points back at the building IRI.
# Source: buildingParser.ts SOSA observation pass (:288, :375).
<InvestorObservation> {
  rdf:type                  [ sosa:Observation ] ;
  sosa:hasFeatureOfInterest IRI ;                          # the building
  sosa:observedProperty
    [ investor:AnnualElectricityConsumption
      investor:RenewableSelfGeneratedShare
      investor:AnnualHeatConsumption
      investor:AnnualWaterConsumption
      investor:AnnualWastewaterConsumption ] ;
  sosa:phenomenonTime       @<TimeInterval> ;
  sosa:hasResult            @<SimpleResult> ;
}

<OperatingCosts> BlankNode {
  investor:wasteDisposal                     .           ? ;
  investor:insurance                         .           ? ;
  investor:operationInspectionAndMaintenance xsd:boolean ? ;
  investor:routineCleaningOffice             .           ? ;
  investor:routineCleaningWarehouse          .           ? ;
  investor:glassCleaning                     .           ? ;
  investor:exteriorMaintenance               .           ? ;
  investor:security                          .           ? ;
  investor:propertyManagement                .           ? ;
  investor:caretaker                         .           ? ;
  investor:repairAndMaintenance              .           ? ;
}

<Certification> BlankNode {
  rdf:type                     IRI ;          # local name ends with "Certification"
                                              # (e.g. investor:DGNBCertification)
  investor:certificationLevel  xsd:string ? ;
  investor:certificationScope  IRI        ? ;
}

# ─────────────────────────────────────────────────────────────────────────────
# Energy-FILE shapes (the referenced documents, not the building file).
# These are where Dummy/Benchmark vs. User actually diverge.
# ─────────────────────────────────────────────────────────────────────────────

# Dummy / Benchmark: categorical SOSA observations, one observedProperty each,
# mapped into the seven EnergyType categories. Source: energyDataParser.ts:85.
<CategoricalObservation> {
  rdf:type              [ sosa:Observation ] ;
  sosa:observedProperty IRI ;                   # local name → category/property
  sosa:hasResult        @<SimpleResult> ;
  sosa:phenomenonTime   @<TimeInterval> ? ;
}

# User: 15-minute electricity readings. Source: userEnergyParser.ts /
# energyDataParser.ts:29. This type is the user-role fingerprint.
<UserReading> {
  rdf:type            [ uservoc:EnergyConsumptionReading ] ;
  sosa:hasResult      @<SimpleResult> ;
  sosa:phenomenonTime @<TimeInterval> ;
}

<SimpleResult> BlankNode {
  sosa:hasSimpleResult xsd:decimal ;
  ssn:hasUnit          IRI ? ;
}

<TimeInterval> BlankNode {
  time:hasBeginning . ;        # xsd:dateTime in user files, xsd:date for annual
}
