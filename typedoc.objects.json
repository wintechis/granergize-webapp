{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "tsconfig.check.json",
  "entryPointStrategy": "expand",
  "entryPoints": ["src/types"],
  "exclude": ["**/*.test.ts"],
  "out": "docs/api/objects",
  "name": "Granergize object model",
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "intentionallyNotExported": [
    "OperatingCostsFields",
    "EnergyNeed",
    "EnergyGeneration",
    "EnergyStorage",
    "EnergyDistribution",
    "EnergyTransfer",
    "EnergyUsage",
    "EnvironmentalFactor"
  ],
  "validation": {
    "invalidLink": false
  }
}
