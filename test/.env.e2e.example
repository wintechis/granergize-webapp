# E2E credentials template — copy to `.env.e2e.local` (gitignored) and fill in.
#   cp .env.e2e.example .env.e2e.local
#   # edit .env.e2e.local — fill in usernames/passwords
#   source .env.e2e.local && deno task e2e <spec>
#
# THROWAWAY Solid Pods only — never real accounts. Nothing here is committed
# except this placeholder template.
#
# Three accounts:
#   A, B — fast Pods, interchangeable for most specs (`sharing` uses both).
#   C    — the slow solidcommunity.net Pod, used only by `screenshots`
#          (so the in-app guide shows canonical solidcommunity.net URIs).

# --- Account A (fast Pod) ---
export E2E_USERNAME_A=alice
export E2E_PASSWORD_A=
export E2E_ISSUER_A=https://example-fast-pod.org

# --- Account B (fast Pod; the sharing recipient — WebID discovered via the room) ---
export E2E_USERNAME_B=bob
export E2E_PASSWORD_B=
export E2E_ISSUER_B=https://example-fast-pod.org

# --- Account C (slow solidcommunity.net Pod; screenshots only) ---
export E2E_USERNAME_C=carol
export E2E_PASSWORD_C=
export E2E_ISSUER_C=https://solidcommunity.net   # optional; this is the default

# --- Optional account selectors (which fast Pod a single-account spec uses) ---
# export E2E_SMOKE_ACCOUNT=A   # storage-smoke / energy-smoke (default B)
# export E2E_DEBUG_ACCOUNT=A   # data-rooms / data-room-switch-debug (defaults: A / B)
