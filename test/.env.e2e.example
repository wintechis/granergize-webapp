# E2E credentials template — copy to a `.local` file (gitignored) and fill in.
#   cp test/.env.e2e.example test/.env.e2e.local
#   # edit test/.env.e2e.local — fill in usernames/passwords
#
# THROWAWAY Solid Pods only — never real accounts. Nothing here is committed
# except this placeholder template.
#
# THREE ROLES — A = Alice, B = Bob, C = Charlie (the benchmark service provider).
# You configure the Pod/WebID each role uses per run; the specs never map to
# providers themselves:
#   - solo specs (login, organisation, add-building, energy-entry, aggregations,
#     data-room, excel-import/export, building-details)  -> Alice (A)
#   - sharing specs (share-building, share-aggregation)          -> Alice + Bob (A + B)
#   - benchmark spec                                      -> Alice + Bob + Charlie (A + B + C)
#   - screenshots (support)                               -> Alice (A)
#   - reset                                               -> Alice + Bob (A + B)
#
# Per role X (A, B or C): WEBID_X_USERNAME + WEBID_X_PASSWORD, plus EITHER WEBID_X_PROVIDER
# (a providers.ts id: solidcommunity | redpencil | solidweb) OR WEBID_X_ISSUER (the
# issuer URL, mapped back to a provider). WEBID_X overrides a derived WebID.
# Lines use `export` so a plain `source <file>` reaches the test process.
#
# RUN (credentials come from the shell — source the file you want, then run):
#   source test/.env.e2e.local && deno task e2e:remote          # solo + sharing
#   source test/.env.e2e.local && \
#     deno task e2e:remote:spec test/e2e/solo/organisation.spec.ts   # one spec
#
# DIFFERENT PROVIDERS — keep several scenario files and source the one you want.
# Use the `.local` suffix so .gitignore (`.env.*.local`) ignores them:
#   test/.env.e2e.solidcommunity.local   # A + B on solidcommunity (sharing works)
#   test/.env.e2e.solidweb.local         # A on solidweb (NSS) — solo on NSS
#   test/.env.e2e.redpencil.local        # A on redpencil (CSS v5) — solo on CSS v5
#   source test/.env.e2e.solidweb.local && deno task e2e:remote
# (Sharing needs A + B to interoperate — same provider, or WEBID_INTEROP_OK=1.)

# --- Role A = Alice (solo + sharing) ---
export WEBID_A_USERNAME=alice
export WEBID_A_PASSWORD=
export WEBID_A_PROVIDER=solidcommunity
# export WEBID_A_ISSUER=https://...   # alternative to WEBID_A_PROVIDER
# export WEBID_A=https://...    # optional: override the derived WebID

# --- Role B = Bob (sharing partner; WebID discovered via the room) ---
export WEBID_B_USERNAME=bob
export WEBID_B_PASSWORD=
export WEBID_B_PROVIDER=solidcommunity

# --- Role C = Charlie (benchmark service provider; only the benchmark spec needs it) ---
export WEBID_C_USERNAME=charlie
export WEBID_C_PASSWORD=
export WEBID_C_PROVIDER=solidcommunity
