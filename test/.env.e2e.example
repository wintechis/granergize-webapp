# E2E credentials template — copy to `.env.e2e.local` (gitignored) and fill in.
#   cp test/.env.e2e.example test/.env.e2e.local
#   # edit test/.env.e2e.local — fill in usernames/passwords
#
# THROWAWAY Solid Pods only — never real accounts. Nothing here is committed
# except this placeholder template.
#
# Four accounts, bound to spec GROUPS by convention (you never map specs one by
# one — you fill two groups):
#   A, B — two Pods on ONE provider (e.g. solidcommunity.net). The SHARING specs
#          (share-building, share-view) use the A+B pair; `screenshots` uses A.
#          Two distinct Pods on the same server interoperate, so cross-Pod sharing
#          actually RUNS now (it used to skip for lack of an interoperating pair).
#   C, D — two single-account ("solo") Pods on DIFFERENT providers (e.g. solidweb
#          + redpencil). The solo specs run against ONE Pod, chosen by E2E_SOLO
#          (a slot id; default C). Run E2E_SOLO=C and E2E_SOLO=D to cover both —
#          different hosts, so the two runs go in parallel (test/run-e2e.sh).
#
# Per slot X: E2E_USERNAME_X + E2E_PASSWORD_X, plus EITHER E2E_PROVIDER_X (a
# providers.ts id: solidcommunity | redpencil | solidweb) OR E2E_ISSUER_X (the
# issuer URL, mapped back to a provider). E2E_WEBID_X overrides a derived WebID.
#
#   deno task e2e:solo       # solo specs on both solo Pods (C + D, in parallel)
#   deno task e2e:sharing    # sharing specs on the A+B pair
#   deno task e2e:all        # everything: solo C+D (parallel) + sharing

# --- Account A (sharing pair; solidcommunity.net) ---
export E2E_USERNAME_A=alice
export E2E_PASSWORD_A=
export E2E_PROVIDER_A=solidcommunity

# --- Account B (sharing pair; solidcommunity.net — recipient, WebID via the room) ---
export E2E_USERNAME_B=bob
export E2E_PASSWORD_B=
export E2E_PROVIDER_B=solidcommunity

# --- Account C (solo Pod; solidweb.org / NSS) ---
export E2E_USERNAME_C=carol
export E2E_PASSWORD_C=
export E2E_PROVIDER_C=solidweb

# --- Account D (solo Pod; solid.redpencil.io / CSS v5) ---
export E2E_USERNAME_D=dave
export E2E_PASSWORD_D=
export E2E_PROVIDER_D=redpencil

# --- Optional: which solo Pod the solo specs use (slot id; default C) ---
# export E2E_SOLO=D
