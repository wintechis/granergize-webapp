// Granergize-App — UX overview (a poor-man's statechart: coarse surfaces +
// the transitions between them, one level above a full statechart).
//
// Layers: the app-shell TABS (free-switching finders, each with its GUISE
// sub-states), the DETAIL surfaces you drill into, and the DIALOGS (modal; return
// to their caller on save/cancel). The ⌘K palette is a global overlay reaching every
// tab (navigate) and the focused object's verbs (invoke).
//
// Edge legend:  solid = open / navigate (full detail-on-demand)
//               dashed (green) = hover peek (in-place detail-on-demand)
//               dashed (grey) = dialog return (save/cancel → caller)
//               dotted = guise toggle  ·  orange dotted = ⌘K palette
//
// Render: `dot -Tsvg ux-overview.dot -o ux-overview.svg`.
digraph ux {
  rankdir=LR;
  compound=true;
  fontname="Helvetica";
  labelloc="t";
  label="Granergize-App — UX overview (with dialog return-edges)";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=11, margin="0.11,0.06"];
  edge [fontname="Helvetica", fontsize=9, color="#777777", arrowsize=0.7];

  Login [fillcolor="#e3f2fd", shape=box, style="filled"];
  Palette [label="⌘K command palette\nnavigate · invoke verbs",
           shape=note, fillcolor="#fff8e1"];
  Peek [label="hover peek\n(tooltip / hover card)", shape=note, fillcolor="#e8f5e9"];

  // ── App-shell tabs (switch freely), the multi-guise ones as a cluster of
  // GUISE sub-states; the list-only finders are single nodes. ──
  subgraph cluster_buildings {
    label="Buildings finder"; style="dashed"; color="#9e9e9e"; fontsize=10;
    B_list [label="list"];
    B_map  [label="map\ngeographic (ownership)"];
    B_list -> B_map [dir=both, style=dotted, label="guise"];
  }
  subgraph cluster_obs {
    label="Observations finder (energy cube)"; style="dashed"; color="#9e9e9e"; fontsize=10;
    O_map       [label="map\nenergy @ year"];
    O_list      [label="list"];
    O_overtime  [label="over-time\n(heatmap)"];
    O_overyears [label="over-years\n(lines)"];
    O_map -> O_list           [dir=both, style=dotted, label="guise"];
    O_list -> O_overtime      [dir=both, style=dotted];
    O_overtime -> O_overyears [dir=both, style=dotted];
  }
  subgraph cluster_agg {
    label="Aggregations finder"; style="dashed"; color="#9e9e9e"; fontsize=10;
    A_list     [label="list"];
    A_map      [label="map\nchoropleth"];
    A_timeline [label="timeline"];
    A_list -> A_map      [dir=both, style=dotted, label="guise"];
    A_map  -> A_timeline [dir=both, style=dotted];
  }
  subgraph cluster_singletabs {
    label="App shell — other tabs (list-only)"; style="dashed"; color="#9e9e9e"; fontsize=10;
    Sharing      [label="Sharing finder"];
    Agents       [label="Agents"];
    Meet         [label="Meet / rooms"];
  }

  // ── Detail surfaces (drilled into) ──
  subgraph cluster_detail {
    label="Detail surfaces"; style="dashed"; color="#9e9e9e"; fontsize=10;
    BuildingPage    [label="Building page\nmaster data · systems · sharing"];
    ObservationPage [label="Observation page\nannual | series · per-unit"];
    AggregationPage [label="Aggregation page"];
    RegionalPage    [label="Regional dataset"];
    RoomPage        [label="Room page"];
  }

  // ── Dialogs (modal · return to caller on save/cancel) ──
  subgraph cluster_dialogs {
    label="Dialogs (modal · return to caller)"; style="dashed"; color="#9e9e9e"; fontsize=10;
    node [fillcolor="#ede7f6"];
    CreateBuilding   [label="Create building"];
    EditBuilding  [label="Edit building"];
    ShareBuilding [label="Share"];
    EnergySystems [label="Energy systems\n(units: add/edit)"];
    EnergyEntry   [label="Energy entry\nobserve for: building | unit"];
    CreateAgg     [label="Create aggregation"];
  }

  Login -> B_list [label="log in"];

  // ── Details-on-demand: hover = in-place peek, click = open the detail page ──
  B_map  -> Peek            [style=dashed, color="#43a047", label="hover marker"];
  A_map  -> Peek            [style=dashed, color="#43a047", label="hover region"];
  O_map  -> Peek            [style=dashed, color="#43a047", label="hover marker"];
  B_map  -> BuildingPage    [label="click marker → open"];
  B_list -> BuildingPage    [label="click row → open"];
  A_list -> AggregationPage [label="open (own/received)"];
  A_timeline -> AggregationPage [label="open"];
  A_list -> RegionalPage    [label="open (open tier)"];
  O_map  -> ObservationPage [label="open"];
  O_list -> ObservationPage [label="open"];
  Sharing      -> BuildingPage    [label="open"];
  Meet         -> RoomPage        [label="open"];

  // detail ↔ detail
  BuildingPage -> ObservationPage [label="energy", dir=both, color="#555555"];

  // detail / finder → dialogs
  B_list          -> CreateBuilding   [label="add"];
  BuildingPage    -> EditBuilding  [label="edit"];
  BuildingPage    -> ShareBuilding [label="share"];
  BuildingPage    -> EnergySystems [label="systems"];
  ObservationPage -> EnergyEntry   [label="enter"];
  A_list          -> CreateAgg     [label="create"];

  // dialog return-edges: on save/cancel a modal closes back to its caller
  // (constraint=false so the back-edges don't fight the left→right layout)
  edge [style=dashed, color="#bdbdbd", constraint=false, label="done"];
  CreateBuilding   -> B_list;
  EditBuilding  -> BuildingPage;
  ShareBuilding -> BuildingPage;
  EnergySystems -> BuildingPage;
  EnergyEntry   -> ObservationPage;
  CreateAgg     -> A_list;
  edge [style=solid, color="#777777", constraint=true, label=""]; // reset defaults

  // ⌘K palette: global overlay (any tab · the focused object's verbs)
  Palette -> B_list        [style=dotted, color="#f9a825", label="navigate (any tab)"];
  Palette -> ShareBuilding [style=dotted, color="#f9a825", label="invoke (focused object)"];
}
