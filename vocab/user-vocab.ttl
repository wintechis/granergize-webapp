# Granergize user vocabulary — published at
#   https://solid.ti.rw.fau.de/private/granergize/user-vocab.ttl#
# Source of truth is this file in the app repo (see vocab/README.md). No document
# was previously published at this URL; authored from the terms the app reads/
# writes (userEnergyParser.ts, energySeriesXlsx.ts).

@prefix :    <#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

<#> rdf:type owl:Ontology ;
    rdfs:label "Granergize user vocabulary"@en .

# A single sub-hourly energy-meter reading (a sosa:Observation: observedProperty +
# featureOfInterest + result + phenomenonTime). Many readings make up a daily
# series file in a building's energy/ container.
:EnergyConsumptionReading rdf:type owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Energy consumption reading"@en .
