# Granergize building vocabulary — published at
#   https://solid.ti.rw.fau.de/gra/building.ttl#
# Source of truth is this file in the app repo (see vocab/README.md).
#
# A RealEstateCore extension profile: every property here describes a
# rec:Building (or a component node hanging off one) with logistics-real-estate
# master data. Alignment policy: external alignment is asserted ONLY as ENTAILING
# relations — rdfs:subClassOf /
# rdfs:subPropertyOf / owl:equivalentClass / owl:equivalentProperty, and
# rdfs:domain / rdfs:range — never rdfs:seeAlso (a pointer with no entailment).
# Where a flat master-data property does not structurally match REC/Brick's shape
# (e.g. an area as a building→m² literal vs REC's area-component node), nothing is
# asserted rather than a decorative link; those connections appear once the data is
# structured (the technical-system / area component nodes). The structural spine
# (rec:Building, rec:ownedBy, rec:operatedBy, geo, vCard, schema.org, FOAF, PROV)
# is reused directly, not wrapped.

@prefix :      <#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec:   <https://w3id.org/rec#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix geo:   <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<#> rdf:type owl:Ontology ;
    rdfs:label "Granergize building vocabulary"@en ;
    rdfs:label "Granergize-Gebäudevokabular"@de ;
    rdfs:label "Vocabulaire des bâtiments Granergize"@fr ;
    rdfs:comment "Logistics-real-estate master data for rec:Building resources."@en ;
    rdfs:comment "Logistik-Immobilien-Stammdaten für rec:Building-Ressourcen."@de ;
    rdfs:comment "Données de référence immobilières logistiques pour les ressources rec:Building."@fr .

############################
###   Master data        ###
############################

:buildingCode rdf:type owl:DatatypeProperty ;
    rdfs:label "building code"@en ; rdfs:label "Gebäudecode"@de ; rdfs:label "code du bâtiment"@fr ;
    rdfs:comment "The owner's internal identifier for the building."@en ;
    rdfs:comment "Die interne Kennung des Eigentümers für das Gebäude."@de ;
    rdfs:comment "L'identifiant interne du propriétaire pour le bâtiment."@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

:yearOfConstruction rdf:type owl:DatatypeProperty ;
    rdfs:label "Year of construction"@en ; rdfs:label "Baujahr"@de ; rdfs:label "Année de construction"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:integer .

:yearOfRenovation rdf:type owl:DatatypeProperty ;
    rdfs:label "Year of renovation"@en ; rdfs:label "Sanierungsjahr"@de ; rdfs:label "Année de rénovation"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:integer .

# Areas are flat literals (m²). REC models areas on a component node
# (rec:area → rec:ArchitectureArea with grossArea/netArea/rentableArea) and Brick
# as structured entity properties — a different shape, so no formal relation is
# asserted (a flat building→m² literal does not subsume the node-based form).
:hasBuildingArea rdf:type owl:DatatypeProperty ;
    rdfs:label "Building area (m²)"@en ; rdfs:label "Gebäudefläche (m²)"@de ; rdfs:label "Surface du bâtiment (m²)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:integer .

:hasLandArea rdf:type owl:DatatypeProperty ;
    rdfs:label "Land area (m²)"@en ; rdfs:label "Grundstücksfläche (m²)"@de ; rdfs:label "Surface du terrain (m²)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:integer .

:officeArea rdf:type owl:DatatypeProperty ;
    rdfs:label "Office area (m²)"@en ; rdfs:label "Bürofläche (m²)"@de ; rdfs:label "Surface de bureaux (m²)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:integer .

:hallArea rdf:type owl:DatatypeProperty ;
    rdfs:label "Hall area (m²)"@en ; rdfs:label "Hallenfläche (m²)"@de ; rdfs:label "Surface de hall (m²)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:decimal .

:officeSocialArea rdf:type owl:DatatypeProperty ;
    rdfs:label "Office & social area (m²)"@en ; rdfs:label "Büro- und Sozialfläche (m²)"@de ; rdfs:label "Surface de bureaux et locaux sociaux (m²)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:decimal .

:buildingHeight rdf:type owl:DatatypeProperty ;
    rdfs:label "Building height (m)"@en ; rdfs:label "Gebäudehöhe (m)"@de ; rdfs:label "Hauteur du bâtiment (m)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:decimal .

:numberOfLoadingDocks rdf:type owl:DatatypeProperty ;
    rdfs:label "Number of loading docks"@en ; rdfs:label "Anzahl der Ladetore"@de ; rdfs:label "Nombre de quais de chargement"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:integer .

:usedAs rdf:type owl:DatatypeProperty ;
    rdfs:label "Used as"@en ; rdfs:label "Genutzt als"@de ; rdfs:label "Utilisé comme"@fr ;
    rdfs:comment "Free-text usage of the building."@en ;
    rdfs:comment "Freitext-Nutzung des Gebäudes."@de ;
    rdfs:comment "Usage du bâtiment en texte libre."@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

:logisticsFunction rdf:type owl:DatatypeProperty ;
    rdfs:label "Logistics function"@en ; rdfs:label "Logistikfunktion"@de ; rdfs:label "Fonction logistique"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

:climateControlType rdf:type owl:DatatypeProperty ;
    rdfs:label "Climate control type"@en ; rdfs:label "Art der Klimatisierung"@de ; rdfs:label "Type de régulation climatique"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

:greenLeaseShare rdf:type owl:DatatypeProperty ;
    rdfs:label "Green lease share (%)"@en ; rdfs:label "Anteil Green Lease (%)"@de ; rdfs:label "Part de bail vert (%)"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:decimal .

:leaseType rdf:type owl:DatatypeProperty ;
    rdfs:label "Lease type"@en ; rdfs:label "Mietvertragsart"@de ; rdfs:label "Type de bail"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

:tenantIndustry rdf:type owl:DatatypeProperty ;
    rdfs:label "Tenant industry"@en ; rdfs:label "Branche des Mieters"@de ; rdfs:label "Secteur du locataire"@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

:companyName rdf:type owl:DatatypeProperty ;
    rdfs:label "Company name"@en ; rdfs:label "Firmenname"@de ; rdfs:label "Nom de l'entreprise"@fr ;
    rdfs:comment "Denormalised name of the company behind the building; candidate for retirement in favour of the agent's profile."@en ;
    rdfs:comment "Denormalisierter Name des Unternehmens hinter dem Gebäude; Kandidat für die Abschaffung zugunsten des Agentenprofils."@de ;
    rdfs:comment "Nom dénormalisé de l'entreprise derrière le bâtiment ; candidat à la suppression au profit du profil de l'agent."@fr ;
    rdfs:domain rec:Building ; rdfs:range xsd:string .

# Agent links: building→agent relationship properties, each identifying the
# agent by WebID (foaf:Agent) — the same shape as rec:ownedBy / rec:operatedBy,
# which the app reuses directly. These are relationships of a building, NOT
# roles of a person (roles exist only as data-room membership).
:investor rdf:type owl:ObjectProperty ;
    rdfs:label "Investor"@en ; rdfs:label "Investor"@de ; rdfs:label "Investisseur"@fr ;
    rdfs:comment "The building's investor, identified by WebID."@en ;
    rdfs:comment "Der Investor des Gebäudes, identifiziert per WebID."@de ;
    rdfs:comment "L'investisseur du bâtiment, identifié par WebID."@fr ;
    rdfs:domain rec:Building ; rdfs:range foaf:Agent .

:facilityManagedBy rdf:type owl:ObjectProperty ;
    rdfs:label "Facility manager"@en ; rdfs:label "Facility Manager"@de ; rdfs:label "Gestionnaire d'installations"@fr ;
    rdfs:comment "The building's facility manager, identified by WebID. Distinct from rec:operatedBy (the operator running the building's use)."@en ;
    rdfs:comment "Der Facility Manager des Gebäudes, identifiziert per WebID. Abzugrenzen von rec:operatedBy (der Betreiber, der die Nutzung des Gebäudes führt)."@de ;
    rdfs:comment "Le gestionnaire d'installations du bâtiment, identifié par WebID. Distinct de rec:operatedBy (l'exploitant qui assure l'usage du bâtiment)."@fr ;
    rdfs:domain rec:Building ; rdfs:range foaf:Agent .

:developedBy rdf:type owl:ObjectProperty ;
    rdfs:label "Developed by"@en ; rdfs:label "Entwickelt von"@de ; rdfs:label "Développé par"@fr ;
    rdfs:comment "The project developer that developed the building, identified by WebID."@en ;
    rdfs:comment "Der Projektentwickler, der das Gebäude entwickelt hat, identifiziert per WebID."@de ;
    rdfs:comment "Le promoteur qui a développé le bâtiment, identifié par WebID."@fr ;
    rdfs:domain rec:Building ; rdfs:range foaf:Agent .

:consultedBy rdf:type owl:ObjectProperty ;
    rdfs:label "Consultant / broker"@en ; rdfs:label "Berater / Makler"@de ; rdfs:label "Conseiller / courtier"@fr ;
    rdfs:comment "A consultant or broker advising on / marketing the building, identified by WebID."@en ;
    rdfs:comment "Ein Berater oder Makler, der das Gebäude berät / vermarktet, identifiziert per WebID."@de ;
    rdfs:comment "Un conseiller ou courtier qui conseille sur / commercialise le bâtiment, identifié par WebID."@fr ;
    rdfs:domain rec:Building ; rdfs:range foaf:Agent .

# Reused external terms — annotated in our profile so the app generates from the
# vocab: a display label (de/en/fr) for fieldLabel(), and for the agent links the
# range (foaf:Agent) so the schema generator classifies them as WebID references.
# (schema:customer / rec:nace-code are plain string literals — no range needed, the
# generator defaults an undeclared field to xsd:string, as the app does today.)
rec:operatedBy rdf:type owl:ObjectProperty ; rdfs:range foaf:Agent ;
    rdfs:label "Operated by"@en ; rdfs:label "Betrieben von"@de ; rdfs:label "Exploité par"@fr .
rec:ownedBy rdf:type owl:ObjectProperty ; rdfs:range foaf:Agent ;
    rdfs:label "Owned by"@en ; rdfs:label "Eigentümer"@de ; rdfs:label "Propriétaire"@fr .
rec:nace-code rdfs:label "NACE code"@en ; rdfs:label "NACE-Code"@de ; rdfs:label "Code NACE"@fr .
schema:customer rdfs:label "Customer"@en ; rdfs:label "Kunde"@de ; rdfs:label "Client"@fr .

############################
###   Technical systems  ###
############################

# A technical building system (PV, …) is a COMPONENT NODE of the building — a
# subordinate resource (a hash-URI fragment in the building document, no detail
# page; rendered attached to the building, see notes/building-detail.md). Modelled
# as a node, not a flat flag, so it can carry its own attributes AND agents: a PV
# plant has a capacity, a commissioning year, and an operator that may differ from
# the building's (rec:operatedBy on the SYSTEM = the plant operator, e.g. the MaStR
# Anlagenbetreiber; rec:operatedBy on the BUILDING = the building's user/operator).
# owl:sameAs links the node to its external registry identity (the MaStR Einheit).
# Battery storage is likewise a :TechnicalSystem node (the <#battery> :BatteryStorage,
# its capacity in kWh of usable energy); heating boilers remain flat presence flags
# below (no per-asset source), while a registered cogeneration plant would be a node.
:hasSystem rdf:type owl:ObjectProperty ;
    rdfs:label "has system"@en ; rdfs:label "hat Anlage"@de ; rdfs:label "possède un système"@fr ;
    rdfs:subPropertyOf brick:hasPart ;
    rdfs:domain rec:Building ; rdfs:range :TechnicalSystem .

:TechnicalSystem rdf:type rdfs:Class ;
    rdfs:label "Technical system"@en ; rdfs:label "Technische Anlage"@de ; rdfs:label "Système technique"@fr ;
    rdfs:subClassOf brick:Equipment , sosa:System .

:PVSystem rdf:type rdfs:Class ;
    rdfs:label "Photovoltaic system"@en ; rdfs:label "Photovoltaik-Anlage"@de ; rdfs:label "Installation photovoltaïque"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:PV_Generation_System .

:BatteryStorage rdf:type rdfs:Class ;
    rdfs:label "Battery storage"@en ; rdfs:label "Batteriespeicher"@de ; rdfs:label "Stockage par batterie"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:Battery .

:CHPSystem rdf:type rdfs:Class ;
    rdfs:label "Cogeneration plant"@en ; rdfs:label "Kraft-Wärme-Kopplung"@de ; rdfs:label "Installation de cogénération"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:CHP .

:capacityKW rdf:type owl:DatatypeProperty ;
    rdfs:label "capacity (kW)"@en ; rdfs:label "Leistung (kW)"@de ; rdfs:label "puissance (kW)"@fr ;
    rdfs:domain :TechnicalSystem ; rdfs:range xsd:decimal .

:commissioningYear rdf:type owl:DatatypeProperty ;
    rdfs:label "commissioning year"@en ; rdfs:label "Inbetriebnahmejahr"@de ; rdfs:label "année de mise en service"@fr ;
    rdfs:domain :TechnicalSystem ; rdfs:range xsd:gYear .

# Usable energy capacity (kWh) of a battery storage node — distinct from :capacityKW
# (nameplate power). Domain is the :BatteryStorage node, not the building.
:storageCapacityKWh rdf:type owl:DatatypeProperty ;
    rdfs:label "Usable storage capacity (kWh)"@en ; rdfs:label "Nutzbare Speicherkapazität (kWh)"@de ; rdfs:label "Capacité de stockage utile (kWh)"@fr ;
    rdfs:domain :BatteryStorage ; rdfs:range xsd:decimal .

# Thermal output (kW) of a CHP or a heat generator (heat pump / boiler / district-heating)
# node — its heat side, distinct from the electrical :capacityKW.
:thermalCapacityKW rdf:type owl:DatatypeProperty ;
    rdfs:label "Thermal output (kW)"@en ; rdfs:label "Thermische Nutzleistung (kW)"@de ; rdfs:label "Puissance thermique (kW)"@fr ;
    rdfs:domain :TechnicalSystem ; rdfs:range xsd:decimal .

############################
###   Heat generation    ###
############################

# Heat generators are :TechnicalSystem component nodes (bldg:hasSystem), like PV / battery
# / CHP — each carrying :thermalCapacityKW + :commissioningYear — NOT boolean flags on the
# building. Aligned to Brick equipment classes where the shape matches.
:HeatPump rdf:type rdfs:Class ;
    rdfs:label "Heat pump"@en ; rdfs:label "Wärmepumpe"@de ; rdfs:label "Pompe à chaleur"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:Heat_Pump .

:GasBoiler rdf:type rdfs:Class ;
    rdfs:label "Gas boiler"@en ; rdfs:label "Gaskessel"@de ; rdfs:label "Chaudière à gaz"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:Boiler .

:OilBoiler rdf:type rdfs:Class ;
    rdfs:label "Oil boiler"@en ; rdfs:label "Ölkessel"@de ; rdfs:label "Chaudière à fioul"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:Boiler .

:ElectricBoiler rdf:type rdfs:Class ;
    rdfs:label "Electric boiler"@en ; rdfs:label "Elektrokessel"@de ; rdfs:label "Chaudière électrique"@fr ;
    rdfs:subClassOf :TechnicalSystem , brick:Boiler .

# A district-heating connection (grid supply, not on-site equipment), so no Brick
# equipment subsumption — just a :TechnicalSystem node carrying its thermal capacity.
:DistrictHeating rdf:type rdfs:Class ;
    rdfs:label "District heating"@en ; rdfs:label "Fernwärme"@de ; rdfs:label "Chauffage urbain"@fr ;
    rdfs:subClassOf :TechnicalSystem .

############################
###   Controlled vocab   ###
############################

:shiftRegime rdf:type owl:ObjectProperty ;
    rdfs:label "Shift regime"@en ; rdfs:label "Schichtbetrieb"@de ; rdfs:label "Régime de postes"@fr ; rdfs:domain rec:Building ; rdfs:range :ShiftRegime .
:tenancyType rdf:type owl:ObjectProperty ;
    rdfs:label "Tenancy type"@en ; rdfs:label "Mietverhältnisart"@de ; rdfs:label "Type de location"@fr ;
    rdfs:domain rec:Building ; rdfs:range :TenancyType .
:indoorTemperatureClass rdf:type owl:ObjectProperty ;
    rdfs:label "Indoor temperature class"@en ; rdfs:label "Innentemperaturklasse"@de ; rdfs:label "Classe de température intérieure"@fr ; rdfs:domain rec:Building ; rdfs:range :IndoorTemperatureClass .

:ShiftRegime rdf:type rdfs:Class ; rdfs:label "Shift regime"@en ; rdfs:label "Schichtbetrieb"@de ; rdfs:label "Régime de postes"@fr .
:OneShift   rdf:type :ShiftRegime ; rdfs:label "1-Shift"@en ; rdfs:label "1-Schicht"@de ; rdfs:label "1 poste"@fr .
:TwoShift   rdf:type :ShiftRegime ; rdfs:label "2-Shift"@en ; rdfs:label "2-Schicht"@de ; rdfs:label "2 postes"@fr .
:ThreeShift rdf:type :ShiftRegime ; rdfs:label "3-Shift"@en ; rdfs:label "3-Schicht"@de ; rdfs:label "3 postes"@fr .

:TenancyType rdf:type rdfs:Class ; rdfs:label "Tenancy type"@en ; rdfs:label "Mietverhältnisart"@de ; rdfs:label "Type de location"@fr .
:SingleTenant rdf:type :TenancyType ; rdfs:label "Single Tenant"@en ; rdfs:label "Einzelmieter"@de ; rdfs:label "Locataire unique"@fr .
:MultiTenant  rdf:type :TenancyType ; rdfs:label "Multi Tenant"@en ; rdfs:label "Mehrere Mieter"@de ; rdfs:label "Multi-locataires"@fr .

:IndoorTemperatureClass rdf:type rdfs:Class ; rdfs:label "Indoor temperature class"@en ; rdfs:label "Innentemperaturklasse"@de ; rdfs:label "Classe de température intérieure"@fr .
:MaxTwelveDegrees   rdf:type :IndoorTemperatureClass ; rdfs:label "≤12 °C"@en ; rdfs:label "≤12 °C"@de ; rdfs:label "≤12 °C"@fr .
:MaxEighteenDegrees rdf:type :IndoorTemperatureClass ; rdfs:label "≤18 °C"@en ; rdfs:label "≤18 °C"@de ; rdfs:label "≤18 °C"@fr .

############################
###   Operating costs    ###
############################

:hasOperatingCosts rdf:type owl:ObjectProperty ;
    rdfs:label "has operating costs"@en ; rdfs:label "Hat Betriebskosten"@de ; rdfs:label "possède des coûts d'exploitation"@fr ; rdfs:domain rec:Building ; rdfs:range :OperatingCosts .
:OperatingCosts rdf:type rdfs:Class ; rdfs:label "Operating costs"@en ; rdfs:label "Betriebskosten"@de ; rdfs:label "Coûts d'exploitation"@fr .

:wasteDisposal rdf:type owl:ObjectProperty ;
    rdfs:label "waste disposal"@en ; rdfs:label "Abfallentsorgung"@de ; rdfs:label "élimination des déchets"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:insurance rdf:type owl:ObjectProperty ;
    rdfs:label "insurance"@en ; rdfs:label "Versicherung"@de ; rdfs:label "assurance"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:operationInspectionAndMaintenance rdf:type owl:ObjectProperty ;
    rdfs:label "operation, inspection & maintenance"@en ; rdfs:label "Betrieb, Inspektion und Wartung"@de ; rdfs:label "exploitation, inspection et maintenance"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:routineCleaningOffice rdf:type owl:ObjectProperty ;
    rdfs:label "routine cleaning (office)"@en ; rdfs:label "Unterhaltsreinigung (Büro)"@de ; rdfs:label "nettoyage courant (bureaux)"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:routineCleaningWarehouse rdf:type owl:ObjectProperty ;
    rdfs:label "routine cleaning (warehouse)"@en ; rdfs:label "Unterhaltsreinigung (Lager)"@de ; rdfs:label "nettoyage courant (entrepôt)"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:glassCleaning rdf:type owl:ObjectProperty ;
    rdfs:label "glass cleaning"@en ; rdfs:label "Glasreinigung"@de ; rdfs:label "nettoyage des vitres"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:exteriorMaintenance rdf:type owl:ObjectProperty ;
    rdfs:label "exterior maintenance"@en ; rdfs:label "Außenpflege"@de ; rdfs:label "entretien extérieur"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:security rdf:type owl:ObjectProperty ;
    rdfs:label "security"@en ; rdfs:label "Sicherheit"@de ; rdfs:label "sécurité"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:propertyManagement rdf:type owl:ObjectProperty ;
    rdfs:label "property management"@en ; rdfs:label "Objektverwaltung"@de ; rdfs:label "gestion immobilière"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:caretaker rdf:type owl:ObjectProperty ;
    rdfs:label "caretaker"@en ; rdfs:label "Hausmeister"@de ; rdfs:label "concierge"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .
:repairAndMaintenance rdf:type owl:ObjectProperty ;
    rdfs:label "repair & maintenance"@en ; rdfs:label "Reparatur und Wartung"@de ; rdfs:label "réparation et maintenance"@fr ; rdfs:domain :OperatingCosts ; rdfs:range xsd:string .

############################
###   Certifications     ###
############################

:hasBuildingCertification rdf:type owl:ObjectProperty ;
    rdfs:label "has building certification"@en ; rdfs:label "Hat Gebäudezertifizierung"@de ; rdfs:label "possède une certification de bâtiment"@fr ; rdfs:domain rec:Building ; rdfs:range :BuildingCertification .
:BuildingCertification rdf:type rdfs:Class ; rdfs:label "Building certification"@en ; rdfs:label "Gebäudezertifizierung"@de ; rdfs:label "Certification de bâtiment"@fr .
:certificationLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "certification level"@en ; rdfs:label "Zertifizierungsstufe"@de ; rdfs:label "niveau de certification"@fr ; rdfs:domain :BuildingCertification ; rdfs:range xsd:string .
:certificationScope rdf:type owl:DatatypeProperty ;
    rdfs:label "certification scope"@en ; rdfs:label "Zertifizierungsumfang"@de ; rdfs:label "périmètre de certification"@fr ; rdfs:domain :BuildingCertification ; rdfs:range xsd:string .

# The certification systems the app serializes: a cert node carries BOTH
# :BuildingCertification and its system class (see addCertifications).
:BREEAMCertification rdf:type rdfs:Class ; rdfs:subClassOf :BuildingCertification ;
    rdfs:label "BREEAM certification"@en ; rdfs:label "BREEAM-Zertifizierung"@de ; rdfs:label "Certification BREEAM"@fr .
:DGNBCertification rdf:type rdfs:Class ; rdfs:subClassOf :BuildingCertification ;
    rdfs:label "DGNB certification"@en ; rdfs:label "DGNB-Zertifizierung"@de ; rdfs:label "Certification DGNB"@fr .
:LEEDCertification rdf:type rdfs:Class ; rdfs:subClassOf :BuildingCertification ;
    rdfs:label "LEED certification"@en ; rdfs:label "LEED-Zertifizierung"@de ; rdfs:label "Certification LEED"@fr .

############################
###   File attachments   ###
############################

# A building links each uploaded file with :hasAttachment; the file IRI is the
# subject of its schema:MediaObject metadata. The energy certificate is one such
# file, additionally flagged with :hasEnergyCertificate. REC's analogue is
# rec:documentation → rec:Document.
:hasAttachment rdf:type owl:ObjectProperty ;
    rdfs:label "has attachment"@en ; rdfs:label "Hat Anhang"@de ; rdfs:label "possède une pièce jointe"@fr ;
    rdfs:domain rec:Building ; rdfs:range schema:MediaObject .

:hasEnergyCertificate rdf:type owl:ObjectProperty ;
    rdfs:label "has energy certificate"@en ; rdfs:label "Hat Energieausweis"@de ; rdfs:label "possède un certificat énergétique"@fr ;
    rdfs:comment "Flags one attachment (a schema:MediaObject) as the energy certificate."@en ;
    rdfs:comment "Kennzeichnet einen Anhang (ein schema:MediaObject) als den Energieausweis."@de ;
    rdfs:comment "Désigne une pièce jointe (un schema:MediaObject) comme le certificat énergétique."@fr ;
    # No rdfs:range on purpose: the app's field bridge stores this as a FLAT IRI
    # reference (see vocabSchema.test's BUILDING_FIELDS guard); a class range
    # would classify it as a structured node. The target shape is stated in the
    # comment above (a schema:MediaObject, via the hasAttachment super-property).
    rdfs:subPropertyOf :hasAttachment ; rdfs:domain rec:Building .

############################
###   Geocode precision  ###
############################

# Attached to a building's geo:Point: how precisely the coordinate was geocoded.
:geocodePrecision rdf:type owl:ObjectProperty ;
    rdfs:label "geocode precision"@en ; rdfs:label "Geokodierungsgenauigkeit"@de ; rdfs:label "précision du géocodage"@fr ;
    rdfs:domain geo:Point ; rdfs:range :GeocodePrecision .

:GeocodePrecision rdf:type rdfs:Class ; rdfs:label "Geocode precision"@en ; rdfs:label "Geokodierungsgenauigkeit"@de ; rdfs:label "Précision du géocodage"@fr .
:Address rdf:type :GeocodePrecision ; rdfs:label "Address"@en ; rdfs:label "Adresse"@de ; rdfs:label "Adresse"@fr .
:Postcode rdf:type :GeocodePrecision ; rdfs:label "Postcode"@en ; rdfs:label "Postleitzahl"@de ; rdfs:label "Code postal"@fr .
:City rdf:type :GeocodePrecision ; rdfs:label "City"@en ; rdfs:label "Stadt"@de ; rdfs:label "Ville"@fr .
