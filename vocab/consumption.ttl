# Granergize consumption vocabulary — published at
#   https://solid.ti.rw.fau.de/gra/consumption.ttl#
# Source of truth is this file in the app repo (see vocab/README.md).
#
# A SOSA profile: energy observations and everything derived from them. An
# energy dataset is a sosa:ObservationCollection at a declared granularity
# (annual aggregates or sub-hourly series); a reading is a sosa:Observation.
# The derived layer — aggregations and benchmark results — lives here too,
# because an aggregation or benchmark is aggregated consumption data. The linking
# properties to buildings live here, not in the building vocabulary: energy
# depends on buildings, never the reverse.

@prefix :     <#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rec:  <https://w3id.org/rec#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix unit: <https://qudt.org/vocab/unit#> .

<#> rdf:type owl:Ontology ;
    rdfs:label "Granergize consumption vocabulary"@en ;
    rdfs:label "Granergize-Verbrauchsvokabular"@de ;
    rdfs:label "Vocabulaire de consommation Granergize"@fr ;
    rdfs:comment "Energy observations of buildings (SOSA profile) and the aggregations / benchmarks derived from them."@en ;
    rdfs:comment "Energiebeobachtungen von Gebäuden (SOSA-Profil) und die daraus abgeleiteten Aggregationen / Benchmarks."@de ;
    rdfs:comment "Observations énergétiques des bâtiments (profil SOSA) et les agrégations / benchmarks qui en dérivent."@fr .

############################
###   Energy datasets    ###
############################

:EnergyDataset rdf:type rdfs:Class ;
    rdfs:subClassOf sosa:ObservationCollection , prov:Entity ;
    rdfs:label "Energy dataset"@en ; rdfs:label "Energiedatensatz"@de ; rdfs:label "Jeu de données énergétiques"@fr .

:hasEnergyDataset rdf:type owl:ObjectProperty ;
    rdfs:label "has energy dataset"@en ; rdfs:label "hat Energiedatensatz"@de ; rdfs:label "possède un jeu de données énergétiques"@fr ;
    rdfs:domain rec:Building ; rdfs:range :EnergyDataset .

:ofBuilding rdf:type owl:ObjectProperty ;
    rdfs:label "of building"@en ; rdfs:label "von Gebäude"@de ; rdfs:label "du bâtiment"@fr ;
    rdfs:domain :EnergyDataset ; rdfs:range rec:Building .

:datasetLocation rdf:type owl:ObjectProperty ;
    rdfs:label "dataset location"@en ; rdfs:label "Speicherort des Datensatzes"@de ; rdfs:label "emplacement du jeu de données"@fr ;
    rdfs:comment "The stored Turtle resource holding this dataset's observations."@en ;
    rdfs:comment "Die gespeicherte Turtle-Ressource mit den Beobachtungen dieses Datensatzes."@de ;
    rdfs:comment "La ressource Turtle stockée contenant les observations de ce jeu de données."@fr ;
    rdfs:domain :EnergyDataset ; rdfs:range rdfs:Resource .

:granularity rdf:type owl:DatatypeProperty ;
    rdfs:label "granularity"@en ; rdfs:label "Granularität"@de ; rdfs:label "granularité"@fr ;
    rdfs:comment "ISO 8601 duration of one observation period (e.g. P1Y, PT15M)."@en ;
    rdfs:comment "ISO-8601-Dauer eines Beobachtungszeitraums (z. B. P1Y, PT15M)."@de ;
    rdfs:comment "Durée ISO 8601 d'une période d'observation (p. ex. P1Y, PT15M)."@fr ;
    rdfs:domain :EnergyDataset ; rdfs:range xsd:duration .

:scenario rdf:type owl:ObjectProperty ;
    rdfs:label "scenario"@en ; rdfs:label "Szenario"@de ; rdfs:label "scénario"@fr ;
    rdfs:domain :EnergyDataset ; rdfs:range :Scenario .

:Scenario rdf:type rdfs:Class ; rdfs:label "Scenario"@en ; rdfs:label "Szenario"@de ; rdfs:label "Scénario"@fr .
:Actual  rdf:type :Scenario ; rdfs:label "Actual"@en ; rdfs:label "Ist"@de ; rdfs:label "Réel"@fr .
:Planned rdf:type :Scenario ; rdfs:label "Planned"@en ; rdfs:label "Plan"@de ; rdfs:label "Prévu"@fr .

# The canonical app unit an observable property's results are normalised to — read by
# the schema generator to build the metric→unit map (see vocabSchema.generated.ts).
:canonicalUnit rdf:type owl:ObjectProperty ;
    rdfs:label "canonical unit"@en ; rdfs:label "kanonische Einheit"@de ; rdfs:label "unité canonique"@fr ;
    rdfs:domain sosa:ObservableProperty .

# Observable properties used as sosa:observedProperty on energy observations.
:ElectricityConsumption rdf:type sosa:ObservableProperty ;
    :canonicalUnit unit:KiloW-HR ;
    rdfs:label "Electricity consumption"@en ; rdfs:label "Stromverbrauch"@de ; rdfs:label "Consommation d'électricité"@fr .
:HeatConsumption rdf:type sosa:ObservableProperty ;
    :canonicalUnit unit:KiloW-HR ;
    rdfs:label "Heat consumption"@en ; rdfs:label "Wärmeverbrauch"@de ; rdfs:label "Consommation de chaleur"@fr .
:WaterConsumption rdf:type sosa:ObservableProperty ;
    :canonicalUnit unit:M3 ;
    rdfs:label "Water consumption"@en ; rdfs:label "Wasserverbrauch"@de ; rdfs:label "Consommation d'eau"@fr .
:WastewaterConsumption rdf:type sosa:ObservableProperty ;
    :canonicalUnit unit:M3 ;
    rdfs:label "Wastewater consumption"@en ; rdfs:label "Abwasseraufkommen"@de ; rdfs:label "Consommation d'eaux usées"@fr .
:RenewableSelfGeneratedShare rdf:type sosa:ObservableProperty ;
    :canonicalUnit unit:PERCENT ;
    rdfs:label "Renewable self-generated share"@en ; rdfs:label "Anteil selbst erzeugter erneuerbarer Energie"@de ; rdfs:label "Part d'énergie renouvelable autoproduite"@fr .
:ElectricityGeneration rdf:type sosa:ObservableProperty ;
    :canonicalUnit unit:KiloW-HR ;
    rdfs:label "Electricity generation"@en ; rdfs:label "Stromerzeugung"@de ; rdfs:label "Production d'électricité"@fr .

# A single sub-hourly energy-meter reading (observedProperty + featureOfInterest
# + result + phenomenonTime). Many readings make up a daily series file in a
# building's energy/ container.
:EnergyConsumptionReading rdf:type rdfs:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Energy consumption reading"@en ; rdfs:label "Energieverbrauchsmesswert"@de ; rdfs:label "Relevé de consommation énergétique"@fr .

############################
###   Aggregations       ###
############################

# An aggregation's private definition (holds the contributing building IRIs and
# the chosen metric/aggregation) vs. its shareable snapshot (only the computed
# values + a building count — never the contributor list). :Aggregation is the
# common superclass of both, and the sharing-log kind marker for shared
# (snapshot) aggregations.
:Aggregation rdf:type rdfs:Class ;
    rdfs:label "Aggregation"@en ; rdfs:label "Aggregation"@de ; rdfs:label "Agrégation"@fr .

:AggregationDefinition rdf:type rdfs:Class ;
    rdfs:subClassOf :Aggregation ;
    rdfs:label "Aggregation definition"@en ; rdfs:label "Aggregationsdefinition"@de ; rdfs:label "Définition d'agrégation"@fr ;
    rdfs:comment "The private definition of an aggregation: the contributing building IRIs, the chosen metrics and the aggregation method. Stays on the computing agent's Pod and is never shared."@en ;
    rdfs:comment "Die private Definition einer Aggregation: die IRIs der beitragenden Gebäude, die gewählten Kennzahlen und die Aggregationsmethode. Verbleibt auf dem Pod des berechnenden Agenten und wird nie geteilt."@de ;
    rdfs:comment "La définition privée d'une agrégation : les IRI des bâtiments contributeurs, les métriques choisies et la méthode d'agrégation. Reste sur le Pod de l'agent qui la calcule et n'est jamais partagée."@fr .

:AggregationSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf sosa:ObservationCollection , :Aggregation , prov:Entity ;
    rdfs:label "Aggregation snapshot"@en ; rdfs:label "Momentaufnahme der Aggregation"@de ; rdfs:label "Instantané d'agrégation"@fr ;
    rdfs:comment "A computed, shareable copy of an aggregation: only the per-metric values and a building count, never the contributing building IRIs."@en ;
    rdfs:comment "Eine berechnete, teilbare Kopie einer Aggregation: nur die Werte je Kennzahl und eine Gebäudeanzahl, niemals die IRIs der beitragenden Gebäude."@de ;
    rdfs:comment "Une copie calculée et partageable d'une agrégation : uniquement les valeurs par métrique et un nombre de bâtiments, jamais les IRI des bâtiments contributeurs."@fr .

:aggregationId rdf:type owl:DatatypeProperty ;
    rdfs:label "aggregation id"@en ; rdfs:label "Aggregations-ID"@de ; rdfs:label "identifiant d'agrégation"@fr ;
    rdfs:domain :Aggregation ; rdfs:range xsd:string .
:aggregationName rdf:type owl:DatatypeProperty ;
    rdfs:label "aggregation name"@en ; rdfs:label "Aggregationsname"@de ; rdfs:label "nom de l'agrégation"@fr ;
    rdfs:domain :Aggregation ; rdfs:range xsd:string .
:aggregationType rdf:type owl:DatatypeProperty ;
    rdfs:label "aggregation type"@en ; rdfs:label "Aggregationsart"@de ; rdfs:label "type d'agrégation"@fr ;
    rdfs:comment "The aggregation method (e.g. average, sum)."@en ;
    rdfs:comment "Die Aggregationsmethode (z. B. Durchschnitt, Summe)."@de ;
    rdfs:comment "La méthode d'agrégation (p. ex. moyenne, somme)."@fr ;
    rdfs:domain :Aggregation ; rdfs:range xsd:string .
:aggregationPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "aggregation period"@en ; rdfs:label "Zeitraum der Aggregation"@de ; rdfs:label "période de l'agrégation"@fr ;
    rdfs:comment "The year the aggregation's metrics cover."@en ;
    rdfs:comment "Das Jahr, das die Kennzahlen der Aggregation abdecken."@de ;
    rdfs:comment "L'année couverte par les métriques de l'agrégation."@fr ;
    rdfs:domain :Aggregation ; rdfs:range xsd:string .
:benchmark rdf:type owl:DatatypeProperty ;
    rdfs:label "benchmark"@en ; rdfs:label "Benchmark"@de ; rdfs:label "benchmark"@fr ;
    rdfs:comment "Marks an aggregation definition as a benchmark: every computed snapshot derives its :BenchmarkResult typing from this persisted flag, so a recompute cannot strip it."@en ;
    rdfs:comment "Kennzeichnet eine Aggregationsdefinition als Benchmark: jede berechnete Momentaufnahme leitet ihre :BenchmarkResult-Typisierung aus diesem persistierten Kennzeichen ab, sodass eine Neuberechnung es nicht entfernen kann."@de ;
    rdfs:comment "Marque une définition d'agrégation comme benchmark : chaque instantané calculé hérite de son typage :BenchmarkResult de ce drapeau persistant, de sorte qu'un recalcul ne peut pas le retirer."@fr ;
    rdfs:domain :AggregationDefinition ; rdfs:range xsd:boolean .
:createdAt rdf:type owl:DatatypeProperty ;
    rdfs:label "created at"@en ; rdfs:label "erstellt am"@de ; rdfs:label "créé le"@fr ;
    rdfs:domain :AggregationDefinition ; rdfs:range xsd:dateTime .
:lastComputedAt rdf:type owl:DatatypeProperty ;
    rdfs:label "last computed at"@en ; rdfs:label "zuletzt berechnet am"@de ; rdfs:label "dernier calcul le"@fr ;
    rdfs:domain :AggregationDefinition ; rdfs:range xsd:dateTime .
:computedAt rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:label "computed at"@en ; rdfs:label "berechnet am"@de ; rdfs:label "calculé le"@fr ;
    rdfs:domain :AggregationSnapshot ; rdfs:range xsd:dateTime .
:includesBuilding rdf:type owl:ObjectProperty ;
    rdfs:label "includes building"@en ; rdfs:label "umfasst Gebäude"@de ; rdfs:label "inclut le bâtiment"@fr ;
    rdfs:domain :AggregationDefinition ; rdfs:range rec:Building .
:includesMetric rdf:type owl:DatatypeProperty ;
    rdfs:label "includes metric"@en ; rdfs:label "umfasst Kennzahl"@de ; rdfs:label "inclut la métrique"@fr ;
    rdfs:domain :AggregationDefinition ; rdfs:range xsd:string .
:spatialExtent rdf:type owl:ObjectProperty ;
    rdfs:label "spatial extent"@en ; rdfs:label "räumliche Ausdehnung"@de ; rdfs:label "étendue spatiale"@fr ;
    rdfs:comment "The region (a NUTS/LAU concept) this aggregation covers, when its members roll up to one — distinct from the ad-hoc :includesBuilding set."@en ;
    rdfs:comment "Die Region (ein NUTS/LAU-Konzept), die diese Aggregation abdeckt, wenn ihre Mitglieder zu einer zusammenfallen — getrennt von der ad-hoc :includesBuilding-Menge."@de ;
    rdfs:comment "La région (un concept NUTS/LAU) couverte par cette agrégation, lorsque ses membres se regroupent en une seule — distincte de l'ensemble ad hoc :includesBuilding."@fr ;
    rdfs:domain :Aggregation ; rdfs:range skos:Concept .
:extentLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "extent level"@en ; rdfs:label "Ausdehnungsebene"@de ; rdfs:label "niveau d'étendue"@fr ;
    rdfs:comment "Which hierarchy level the :spatialExtent region sits at (e.g. gemeinde, kreis); kept general so a non-administrative hierarchy can be named."@en ;
    rdfs:comment "Auf welcher Hierarchieebene die :spatialExtent-Region liegt (z. B. Gemeinde, Kreis); allgemein gehalten, damit eine nicht-administrative Hierarchie benannt werden kann."@de ;
    rdfs:comment "À quel niveau hiérarchique se situe la région :spatialExtent (p. ex. commune, arrondissement) ; gardé général pour pouvoir nommer une hiérarchie non administrative."@fr ;
    rdfs:domain :Aggregation ; rdfs:range xsd:string .
:buildingCount rdf:type owl:DatatypeProperty ;
    rdfs:label "building count"@en ; rdfs:label "Gebäudeanzahl"@de ; rdfs:label "nombre de bâtiments"@fr ;
    rdfs:domain :AggregationSnapshot ; rdfs:range xsd:integer .
# The snapshot's TIME coordinate — every snapshot carries it, not just a
# :BenchmarkResult (which, being a subclass, is covered by this domain).
:metricPeriod rdf:type owl:DatatypeProperty ;
    rdfs:label "metric period"@en ; rdfs:label "Zeitraum der Kennzahlen"@de ; rdfs:label "période des métriques"@fr ;
    rdfs:comment "The period the snapshot's figures cover — a year (\"2024\") or, for a monthly aggregation, a year-month (\"2024-03\")."@en ;
    rdfs:comment "Der Zeitraum, den die Werte der Momentaufnahme abdecken — ein Jahr (\"2024\") oder, bei einer monatlichen Aggregation, ein Jahr-Monat (\"2024-03\")."@de ;
    rdfs:comment "La période couverte par les valeurs de l'instantané — une année (« 2024 ») ou, pour une agrégation mensuelle, une année-mois (« 2024-03 »)."@fr ;
    rdfs:domain :AggregationSnapshot ; rdfs:range xsd:gYear .

# Snapshot values are COLLAPSED into sosa:ObservationCollection members — one
# sosa:Observation per metric (sosa:observedProperty + sosa:hasResult /
# sosa:hasSimpleResult + ssn:hasUnit), the same shape an energy dataset uses — so
# there are no per-metric `*Value` datatype properties. The observed properties
# are the :…Consumption / :…Generation / :…Share terms defined above.

############################
###   Benchmark results  ###
############################

# A benchmark is an aggregation snapshot a benchmark service provider
# computes over the buildings shared to it and shares back to the contributors.
# As a specialisation of :AggregationSnapshot it inherits the privacy
# property (only aggregate values + a building count travel, never the
# contributor list), and every snapshot reader keeps working.
:BenchmarkResult rdf:type rdfs:Class ;
    rdfs:subClassOf :AggregationSnapshot ;
    rdfs:label "Benchmark result"@en ; rdfs:label "Benchmark-Ergebnis"@de ; rdfs:label "Résultat de benchmark"@fr .

:computedBy rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:label "computed by"@en ; rdfs:label "berechnet von"@de ; rdfs:label "calculé par"@fr ;
    rdfs:comment "The agent (benchmark service provider) that computed this benchmark result."@en ;
    rdfs:comment "Der Agent (Benchmark-Dienstleister), der dieses Benchmark-Ergebnis berechnet hat."@de ;
    rdfs:comment "L'agent (fournisseur de service de benchmark) qui a calculé ce résultat de benchmark."@fr ;
    rdfs:domain :BenchmarkResult ; rdfs:range foaf:Agent .

# The period a benchmark covers is :metricPeriod, defined with the snapshot
# properties above — it is no longer benchmark-specific.
