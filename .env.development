# Development environment configuration
# This file is used when running 'deno task dev'

# linked-wetterdienst (SOSA/QUDT RDF) - fetched directly (the wrapper is CORS-enabled)
VITE_WEATHER_API_URI=https://wunderfacts.com/wetterdienst/

# linked-regionalstatistik (RDF Data Cube) - fetched directly (the wrapper is CORS-enabled)
VITE_REGIONALSTATISTIK_API_URI=https://wunderfacts.com/regionalstatistik/

# linked-mastr (Marktstammdatenregister, RDF) - fetched directly (the wrapper is CORS-enabled)
VITE_MASTR_API_URI=https://wunderfacts.com/mastr/

# linked-nuts (region polygons for the statistics choropleth, bulk GeoJSON) - fetched directly (CORS-enabled)
VITE_NUTS_API_URI=https://wunderfacts.com/nuts/

# linked-lau (Gemeinde polygons for the choropleth's drill-in level, bulk GeoJSON scoped per Kreis) - fetched directly (CORS-enabled)
VITE_LAU_API_URI=https://wunderfacts.com/lau/

# linked-energieatlas (Bavarian Energie-Atlas, per-Gemeinde RDF) - fetched directly (CORS-enabled)
VITE_LINKED_ENERGIEATLAS_API_URI=https://wunderfacts.com/energieatlas/

# Solid-OIDC Client Identifier Document for dev. A stable named client so dev
# logins stop falling back to dynamic registration (whose cached client_id goes
# stale and yields the CSS "Unknown client" error whenever the IdP's
# registration store is wiped). This is the localhost twin of the prod document
# (.env.production): same publicly-hosted location — a REMOTE IdP must be able
# to dereference it, so it cannot live on localhost — but its `redirect_uris`
# point at the Vite dev server (http://localhost:5173/, plus :4173 for the
# Tier-4 e2e:remote dev server, which also reads this file). Served from
# `public/clientid.dev.jsonld`; takes effect once that file is deployed to the
# public host above (CI publishes `dist/` on push).
VITE_OIDC_CLIENT_ID=https://paul.ti.rw.fau.de/~qa60fyri/testing/granergize/clientid.dev.jsonld
