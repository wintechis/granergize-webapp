{
  "tasks": {
    "dev": "deno run -A npm:vite dev",
    "build": "deno run -A npm:vite build",
    "test": "deno test -A",
    "lint": "deno run -A npm:eslint .",
    "check": "deno run -A npm:typescript/tsc --noEmit -p tsconfig.check.json",
    "e2e:local": "VITE_OIDC_CLIENT_ID= VITE_POD_APP_DIR=granergize-e2e deno task build && deno run -A test/e2e-local/reapStaleServers.ts && E2E_LOCAL=1 npx playwright test --project=local",
    "e2e:local:jss": "LOCAL_POD_SERVER=jss deno task e2e:local",
    "e2e:remote": "npx playwright test --project=solo --project=sharing",
    "e2e:remote:spec": "npx playwright test",
    "e2e:install": "npx playwright install --with-deps chromium",
    "it": "deno run -A --node-modules-dir=auto test/headless/runner.ts",
    "it:jss": "LOCAL_POD_SERVER=jss deno task it",
    "bench": "deno run -A --node-modules-dir=auto test/bench/runner.ts",
    "bench:jss": "LOCAL_POD_SERVER=jss deno task bench",
    "bench:ui": "VITE_OIDC_CLIENT_ID= deno task build && E2E_LOCAL=1 E2E_BENCH=1 npx playwright test --project=bench && deno run -A --node-modules-dir=auto test/bench/plots.ts",
    "bench:plot": "deno run -A test/bench/plots.ts",
    "handbuch": "bash docs/build-handbuch.sh"
  },
  "imports": {
    "@wintechis/wetterdienst-rdf-adapter": "jsr:@wintechis/wetterdienst-rdf-adapter@0.0.53"
  },
  "allowScripts": ["npm:esbuild@0.21.5"]
}
