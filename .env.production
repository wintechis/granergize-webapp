# Production environment configuration
# This file is used when running 'deno task build'

# linked-wetterdienst (SOSA/QUDT RDF) - direct in production (relies on the wrapper's CORS)
VITE_WEATHER_API_URI=https://wunderfacts.com/wetterdienst/

# linked-regionalstatistik (RDF Data Cube) - direct in production (relies on the
# wrapper's CORS; if absent, front with a caching proxy per explore-external-observations).
VITE_REGIONALSTATISTIK_API_URI=https://wunderfacts.com/regionalstatistik/

# linked-mastr (Marktstammdatenregister, RDF) - direct in production (relies on the wrapper's CORS).
VITE_MASTR_API_URI=https://wunderfacts.com/mastr/

# linked-nuts (region polygons for the statistics choropleth, bulk GeoJSON) - direct in production (relies on the wrapper's CORS).
VITE_NUTS_API_URI=https://wunderfacts.com/nuts/

# linked-lau (Gemeinde polygons for the choropleth's drill-in level, scoped per Kreis) - direct in production (relies on the wrapper's CORS).
VITE_LAU_API_URI=https://wunderfacts.com/lau/

# linked-energieatlas (Bavarian Energie-Atlas, per-Gemeinde RDF) - direct in production (CORS-enabled).
VITE_LINKED_ENERGIEATLAS_API_URI=https://wunderfacts.com/energieatlas/

# Solid-OIDC Client Identifier Document. Passing this stable IRI as `clientId`
# makes the provider's consent screen show "Granergize App" (name + logo) instead
# of an opaque dynamically-registered client ID. The document is served from
# `public/clientid.jsonld`; its `redirect_uris` must list this deployment's URL.
# Dev uses a separate twin document (`public/clientid.dev.jsonld`, wired in
# .env.development) whose `redirect_uris` point at localhost; this prod document's
# redirect_uris omit localhost on purpose to keep the prod client's redirects tight.
VITE_OIDC_CLIENT_ID=https://paul.ti.rw.fau.de/~qa60fyri/testing/granergize/clientid.jsonld
